<mj-attributes>
  <mj-all
    font-family="Arial, Helvetica, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif"
    font-size="15px"
    line-height="24px"
    color="#333333"
  />
  <mj-text padding="0 25px 16px 25px" />
  <mj-section padding="20px 0" background-color="#ffffff" />
  <mj-column padding="0" />
  <mj-image padding="0 25px 20px 25px" />
  <mj-button
    font-weight="bold"
    font-size="16px"
    line-height="24px"
    border-radius="6px"
    padding="16px 25px"
    inner-padding="12px 28px"
    background-color="#2563eb"
    color="#ffffff"
    text-decoration="none"
  />
  <mj-divider border-width="1px" border-style="solid" border-color="#e5e7eb" padding="20px 25px" />
  <mj-class
    name="h1"
    font-size="28px"
    line-height="36px"
    font-weight="700"
    color="#111827"
    padding-bottom="12px"
  />
  <mj-class
    name="h2"
    font-size="22px"
    line-height="30px"
    font-weight="600"
    color="#1f2937"
    padding-bottom="10px"
  />
  <mj-class
    name="h3"
    font-size="18px"
    line-height="26px"
    font-weight="600"
    color="#374151"
    padding-bottom="8px"
  />
  <mj-class name="lead" font-size="17px" line-height="26px" color="#4b5563" />
  <mj-class name="caption" font-size="13px" line-height="18px" color="#6b7280" />
  <mj-class
    name="badge"
    font-size="12px"
    font-weight="700"
    color="#2563eb"
    text-transform="uppercase"
    letter-spacing="1px"
  />
</mj-attributes>
