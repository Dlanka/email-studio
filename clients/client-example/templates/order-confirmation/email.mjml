<mjml>
  <mj-head>
    <mj-title>Order Confirmation #ORD-89412</mj-title>
    <mj-preview>Thank you for your order! We are preparing your shipment.</mj-preview>
    <mj-include path="../../../shared/mjml/styles/brand-theme.mjml" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
    </mj-attributes>
    <mj-style>
      .order-table {
        width: 100%;
        border-collapse: collapse;
      }
      .order-table th {
        text-align: left;
        padding: 10px 0;
        border-bottom: 2px solid #e2e8f0;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #64748b;
      }
      .order-table td {
        padding: 14px 0;
        border-bottom: 1px solid #f1f5f9;
        font-size: 14px;
        color: #1e293b;
      }
      .order-summary-row td {
        padding: 6px 0;
        font-size: 14px;
        color: #64748b;
        border-bottom: none;
      }
      .order-total-row td {
        padding: 14px 0;
        font-size: 18px;
        font-weight: bold;
        color: #0f172a;
        border-top: 2px solid #e2e8f0;
        border-bottom: none;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <!-- Header -->
    <mj-section background-color="#ffffff" padding="30px 25px 20px 25px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="24px"
          font-weight="800"
          color="#2563eb"
          letter-spacing="1px"
          padding="0"
        >
          ACME STORE
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Confirmation Banner -->
    <mj-section background-color="#ffffff" padding="10px 25px 25px 25px">
      <mj-column width="100%">
        <mj-divider
          border-width="1px"
          border-style="solid"
          border-color="#e2e8f0"
          padding="0 0 20px 0"
        />
        <mj-text align="center" font-size="36px" padding="0 0 10px 0">📦</mj-text>
        <mj-text mj-class="h1" align="center" padding-bottom="8px"> Order Confirmed! </mj-text>
        <mj-text mj-class="lead" align="center" padding-bottom="20px">
          Hi Morgan, thank you for shopping with us! We have received your order
          <strong>#ORD-89412</strong> and our warehouse team is packing it.
        </mj-text>
        <mj-button
          href="https://example.com/track/ORD-89412"
          background-color="#2563eb"
          color="#ffffff"
          font-size="16px"
          font-weight="bold"
          border-radius="6px"
          inner-padding="12px 28px"
          padding="0 0 20px 0"
        >
          Track Your Package &rarr;
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- Order Meta info -->
    <mj-section background-color="#f8fafc" padding="20px 25px">
      <mj-column width="50%" padding="5px 10px">
        <mj-text
          font-size="12px"
          text-transform="uppercase"
          font-weight="bold"
          color="#64748b"
          padding="0 0 4px 0"
        >
          Shipping Address
        </mj-text>
        <mj-text font-size="14px" line-height="20px" color="#1e293b" padding="0">
          Morgan Reed<br />
          742 Evergreen Terrace<br />
          Springfield, OR 97477
        </mj-text>
      </mj-column>
      <mj-column width="50%" padding="5px 10px">
        <mj-text
          font-size="12px"
          text-transform="uppercase"
          font-weight="bold"
          color="#64748b"
          padding="0 0 4px 0"
        >
          Payment Method
        </mj-text>
        <mj-text font-size="14px" line-height="20px" color="#1e293b" padding="0">
          Visa ending in 4242<br />
          Billing zip: 97477<br />
          Date: Oct 22, 2026
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Itemized Order Table -->
    <mj-section background-color="#ffffff" padding="30px 25px">
      <mj-column width="100%">
        <mj-text mj-class="h2" padding="0 0 16px 0"> Order Summary </mj-text>
        <mj-table padding="0">
          <tr class="order-table-header">
            <th
              style="
                text-align: left;
                padding: 8px 0;
                border-bottom: 2px solid #e2e8f0;
                color: #64748b;
                font-size: 13px;
              "
            >
              Item
            </th>
            <th
              style="
                text-align: center;
                padding: 8px 0;
                border-bottom: 2px solid #e2e8f0;
                color: #64748b;
                font-size: 13px;
              "
            >
              Qty
            </th>
            <th
              style="
                text-align: right;
                padding: 8px 0;
                border-bottom: 2px solid #e2e8f0;
                color: #64748b;
                font-size: 13px;
              "
            >
              Price
            </th>
          </tr>
          <tr>
            <td
              style="
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              <strong>Wireless Noise-Cancelling Headphones</strong><br />
              <span style="font-size: 12px; color: #64748b">Color: Matte Black</span>
            </td>
            <td
              style="
                text-align: center;
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              1
            </td>
            <td
              style="
                text-align: right;
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              $189.00
            </td>
          </tr>
          <tr>
            <td
              style="
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              <strong>Premium Braided USB-C Cable (2m)</strong><br />
              <span style="font-size: 12px; color: #64748b">Color: Charcoal</span>
            </td>
            <td
              style="
                text-align: center;
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              2
            </td>
            <td
              style="
                text-align: right;
                padding: 12px 0;
                border-bottom: 1px solid #f1f5f9;
                color: #1e293b;
                font-size: 14px;
              "
            >
              $38.00
            </td>
          </tr>
          <!-- Subtotals -->
          <tr>
            <td
              colspan="2"
              style="padding: 10px 0 4px 0; color: #64748b; font-size: 14px; text-align: right"
            >
              Subtotal:
            </td>
            <td style="padding: 10px 0 4px 0; color: #1e293b; font-size: 14px; text-align: right">
              $227.00
            </td>
          </tr>
          <tr>
            <td
              colspan="2"
              style="padding: 4px 0; color: #64748b; font-size: 14px; text-align: right"
            >
              Standard Shipping:
            </td>
            <td style="padding: 4px 0; color: #1e293b; font-size: 14px; text-align: right">Free</td>
          </tr>
          <tr>
            <td
              colspan="2"
              style="padding: 4px 0; color: #64748b; font-size: 14px; text-align: right"
            >
              Estimated Tax:
            </td>
            <td style="padding: 4px 0; color: #1e293b; font-size: 14px; text-align: right">
              $18.16
            </td>
          </tr>
          <tr>
            <td
              colspan="2"
              style="
                padding: 14px 0;
                border-top: 2px solid #e2e8f0;
                color: #0f172a;
                font-size: 17px;
                font-weight: bold;
                text-align: right;
              "
            >
              Total:
            </td>
            <td
              style="
                padding: 14px 0;
                border-top: 2px solid #e2e8f0;
                color: #0f172a;
                font-size: 17px;
                font-weight: bold;
                text-align: right;
              "
            >
              $245.16
            </td>
          </tr>
        </mj-table>
      </mj-column>
    </mj-section>

    <!-- Support Help -->
    <mj-section background-color="#f8fafc" padding="25px">
      <mj-column width="100%">
        <mj-text align="center" font-size="14px" line-height="22px" color="#64748b" padding="0">
          Questions regarding your order? Visit our
          <a href="https://example.com/help" style="color: #2563eb; text-decoration: underline"
            >Help Center</a
          >
          or email us at
          <a href="mailto:support@example.com" style="color: #2563eb; text-decoration: underline"
            >support@example.com</a
          >
          with order #ORD-89412.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Shared Footer -->
    <mj-include path="../../../shared/mjml/components/footer.mjml" />
  </mj-body>
</mjml>
