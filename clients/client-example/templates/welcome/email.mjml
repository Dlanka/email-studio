<mjml>
  <mj-head>
    <mj-title>Welcome to Acme Corp!</mj-title>
    <mj-preview
      >Welcome aboard! Here is everything you need to get started with your new account.</mj-preview
    >
    <mj-include path="../../../shared/mjml/styles/brand-theme.mjml" />
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
    </mj-attributes>
    <mj-style>
      .hover-underline:hover {
        text-decoration: underline !important;
      }
      @media only screen and (max-width: 480px) {
        .mobile-center {
          text-align: center !important;
        }
        .mobile-stack {
          width: 100% !important;
        }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f1f5f9">
    <!-- Header -->
    <mj-section background-color="#ffffff" padding="30px 25px 20px 25px">
      <mj-column width="100%">
        <mj-text
          align="center"
          font-size="24px"
          font-weight="800"
          color="#2563eb"
          letter-spacing="1px"
          padding="0"
        >
          ACME CORP
        </mj-text>
        <mj-text
          align="center"
          font-size="12px"
          color="#64748b"
          text-transform="uppercase"
          letter-spacing="2px"
          padding="6px 0 0 0"
        >
          Next Generation Platform
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Hero / Welcome Banner -->
    <mj-section background-color="#ffffff" padding="10px 25px 30px 25px">
      <mj-column width="100%">
        <mj-divider
          border-width="1px"
          border-style="solid"
          border-color="#e2e8f0"
          padding="0 0 25px 0"
        />
        <mj-text mj-class="h1" align="center"> Welcome to the family, Alex! 👋 </mj-text>
        <mj-text mj-class="lead" align="center" padding-bottom="24px">
          We are thrilled to have you with us. Your workspace has been provisioned and is ready for
          your team. Here are the first 3 steps to set up your environment:
        </mj-text>
        <mj-button
          href="https://example.com/dashboard"
          background-color="#2563eb"
          color="#ffffff"
          font-size="16px"
          font-weight="bold"
          border-radius="6px"
          padding="10px 0 25px 0"
          inner-padding="14px 32px"
        >
          Launch Your Dashboard &rarr;
        </mj-button>
      </mj-column>
    </mj-section>

    <!-- 3 Quick Start Steps (Cards) -->
    <mj-section background-color="#f8fafc" padding="25px 15px">
      <mj-column width="33.333%" padding="10px">
        <mj-text align="center" font-size="28px" padding="0 0 10px 0">⚙️</mj-text>
        <mj-text
          align="center"
          font-weight="700"
          font-size="15px"
          color="#1e293b"
          padding="0 0 6px 0"
        >
          1. Connect Tools
        </mj-text>
        <mj-text align="center" font-size="13px" line-height="19px" color="#64748b" padding="0">
          Sync your repos and cloud storage in 2 clicks.
        </mj-text>
      </mj-column>
      <mj-column width="33.333%" padding="10px">
        <mj-text align="center" font-size="28px" padding="0 0 10px 0">👥</mj-text>
        <mj-text
          align="center"
          font-weight="700"
          font-size="15px"
          color="#1e293b"
          padding="0 0 6px 0"
        >
          2. Invite Team
        </mj-text>
        <mj-text align="center" font-size="13px" line-height="19px" color="#64748b" padding="0">
          Add coworkers to share templates and projects.
        </mj-text>
      </mj-column>
      <mj-column width="33.333%" padding="10px">
        <mj-text align="center" font-size="28px" padding="0 0 10px 0">🚀</mj-text>
        <mj-text
          align="center"
          font-weight="700"
          font-size="15px"
          color="#1e293b"
          padding="0 0 6px 0"
        >
          3. First Deploy
        </mj-text>
        <mj-text align="center" font-size="13px" line-height="19px" color="#64748b" padding="0">
          Export production assets and go live today.
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Help & Support Callout -->
    <mj-section background-color="#ffffff" padding="30px 25px">
      <mj-column width="100%">
        <mj-text font-size="15px" line-height="24px" color="#334155" padding="0 0 10px 0">
          Need a hand getting up to speed? Our team is always here for you. Check out our
          <a href="https://example.com/docs" style="color: #2563eb; text-decoration: underline"
            >Documentation Center</a
          >
          or reply directly to this email to speak with your dedicated onboarding specialist.
        </mj-text>
        <mj-text font-size="14px" color="#64748b" padding="10px 0 0 0">
          Cheers,<br />
          <strong>The Acme Team</strong>
        </mj-text>
      </mj-column>
    </mj-section>

    <!-- Footer Component -->
    <mj-include path="../../../shared/mjml/components/footer.mjml" />
  </mj-body>
</mjml>
